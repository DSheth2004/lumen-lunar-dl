<mxCell id="v10" value='&lt;b style="font-size:15px;color:#1C5E39"&gt;5 members · seeds 0–4&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;15 epochs · AdamW · one-cycle LR&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;same architecture, different seeds&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="v11" value='&lt;b style="font-size:15px;color:#374151"&gt;Pretraining objective&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;ℒ = ℒ&lt;sub&gt;comp&lt;/sub&gt; + ℒ&lt;sub&gt;scal&lt;/sub&gt; + auxiliary β-NLL&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;Dirichlet NLL + &lt;i&gt;L&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt; (λ&lt;sub&gt;1&lt;/sub&gt; = 10) · β-NLL on oxides, maturity, grain size, npFe&lt;sup&gt;0&lt;/sup&gt;&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="v12" value='&lt;b style="font-size:15px;color:#1C5E39"&gt;Pretrained weights θ&lt;sub&gt;m&lt;/sub&gt;&lt;sup&gt;0&lt;/sup&gt;&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;5 checkpoints&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;≈ 45 min on 4 CPU cores&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1290" y="60" width="360" height="120" as="geometry"/></mxCell>
