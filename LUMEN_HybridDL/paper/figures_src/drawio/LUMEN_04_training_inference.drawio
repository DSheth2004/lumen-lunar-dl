<mxCell id="v32" value='&lt;b style="font-size:15px;color:#8A5A12"&gt;Lab spectrum&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;RELAB, 71 bands&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#D08C2B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="v33" value='&lt;b style="font-size:15px;color:#8A5A12"&gt;M&lt;sup&gt;3&lt;/sup&gt; pixel spectrum&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;Level-2 reflectance&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#D08C2B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="v34" value='&lt;b style="font-size:15px;color:#1D4A80"&gt;Orbital transfer&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;zero-shot: &lt;i&gt;A&lt;/i&gt;&lt;sub&gt;lab&lt;/sub&gt; = 1.685 &lt;i&gt;A&lt;/i&gt;&lt;sub&gt;M3&lt;/sub&gt; + 0.0355&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;or LUMEN-M3-FT: 600 steps, 16 M&lt;sup&gt;3&lt;/sup&gt; px (FeO only) + 16 lab spectra&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="v35" value='&lt;b style="font-size:15px;color:#4A3278"&gt;Ensemble moments&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;μ = mean&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt; μ&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;σ² = mean&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt; σ²&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt; + Var&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt; μ&lt;sub&gt;&lt;i&gt;m&lt;/i&gt;&lt;/sub&gt;&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;Dirichlet means for composition&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="545" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="v36" value='&lt;b style="font-size:15px;color:#4A3278"&gt;Conformal calibration&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;&lt;i&gt;s&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; = |&lt;i&gt;y&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; − μ&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;| / σ&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;interval μ ± &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;1−&lt;i&gt;a&lt;/i&gt;&lt;/sub&gt; σ&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;out-of-fold scores of other soils (CV+)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="545" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="v37" value="&lt;b style='color:#4A3278'&gt;Gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;95 % CI of&lt;br&gt;&lt;i&gt;S&lt;/i&gt; &amp;gt; 0 ?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1345" y="570" width="150" height="120" as="geometry"/></mxCell>
<mxCell id="v38" value='&lt;b style="font-size:13px;color:#1C5E39"&gt;Map&lt;/b&gt;&lt;div style="margin-top:4px;font-size:11px"&gt;value ± interval&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1530" y="530" width="130" height="90" as="geometry"/></mxCell>
