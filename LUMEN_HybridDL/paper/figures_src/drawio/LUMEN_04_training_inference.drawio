<mxCell id="e23" value="" style="edgeStyle=none;rounded=1;html=1;strokeColor=#374151;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.761;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="v24" value='&lt;b style="font-size:15px;color:#1C5E39"&gt;Fine-tune each member&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;1,500 steps per CV fold&lt;br&gt;AdamW · lr 3×10&lt;sup&gt;−4&lt;/sup&gt; · wd 10&lt;sup&gt;−4&lt;/sup&gt;&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;100-step warm-up, cosine decay · ≈ 6 s each&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="275" width="330" height="165" as="geometry"/></mxCell>
<mxCell id="v25" value='&lt;b style="font-size:15px;color:#374151"&gt;Masked losses&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;Σ&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;m&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt; · β-NLL&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; + ℒ&lt;sub&gt;comp&lt;/sub&gt;&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;&lt;i&gt;m&lt;sub&gt;t&lt;/sub&gt;&lt;/i&gt; drops unavailable targets:&lt;br&gt;mode for &amp;lt;45 µm, all but FeO for M&lt;sup&gt;3&lt;/sup&gt;&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="275" width="300" height="165" as="geometry"/></mxCell>
<mxCell id="v26" value='&lt;b style="font-size:15px;color:#1C5E39"&gt;Fine-tuned ensemble&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;5 members per fold&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;A2 / A4 chosen by inner 5-fold CV&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1430" y="275" width="220" height="165" as="geometry"/></mxCell>
