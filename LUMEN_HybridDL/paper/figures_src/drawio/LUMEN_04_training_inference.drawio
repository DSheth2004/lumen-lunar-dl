<mxCell id="v18" value='&lt;b style="font-size:13px;color:#8A5A12"&gt;16 real&lt;/b&gt;&lt;div style="margin-top:4px;font-size:11px"&gt;training-soil spectra&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#D08C2B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="285" width="145" height="80" as="geometry"/></mxCell>
<mxCell id="v19" value='&lt;b style="font-size:13px;color:#1C5E39"&gt;32 SSA-mixup&lt;/b&gt;&lt;div style="margin-top:4px;font-size:11px"&gt;2–3 soils mixed, Eq. (6)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E8B57;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="268" y="285" width="145" height="80" as="geometry"/></mxCell>
<mxCell id="v20" value='&lt;b style="font-size:13px;color:#1D4A80"&gt;16 replay&lt;/b&gt;&lt;div style="margin-top:4px;font-size:11px"&gt;synthetic spectra&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="426" y="285" width="145" height="80" as="geometry"/></mxCell>
