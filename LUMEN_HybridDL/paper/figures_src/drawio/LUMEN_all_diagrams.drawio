<mxCell id="v6" value='&lt;b style="font-size:15px;color:#1D4A80"&gt;Intimate mixing&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;slab SSA &lt;i&gt;w&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;(&lt;i&gt;D&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;cross-section weights &lt;i&gt;f&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;/&lt;i&gt;D&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;Eqs. (3), (6)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="v7" value='&lt;b style="font-size:15px;color:#1D4A80"&gt;Hapke reflectance&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;&lt;i&gt;r&lt;/i&gt;(&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;mix&lt;/sub&gt;)&lt;br&gt;&lt;i&gt;i&lt;/i&gt; = 30°, &lt;i&gt;e&lt;/i&gt; = 0°&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;Eqs. (1)–(2)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="330" width="220" height="140" as="geometry"/></mxCell>
