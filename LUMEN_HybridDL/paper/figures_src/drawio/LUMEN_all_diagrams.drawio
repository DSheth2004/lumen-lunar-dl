<mxCell id="v3" value='&lt;b style="font-size:15px;color:#8A5A12"&gt;End-member spectra&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;49 RELAB separates&lt;br&gt;and glasses, &lt;i&gt;R&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;(λ)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#D08C2B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="v4" value='&lt;b style="font-size:15px;color:#1D4A80"&gt;Grain optics&lt;/b&gt;&lt;div style="margin-top:4px;font-size:13px"&gt;invert equivalent-slab model&lt;br&gt;⇒ &lt;i&gt;k&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt;(λ)&lt;/div&gt;&lt;div style="margin-top:4px;font-size:12px;color:#6B7280"&gt;Eqs. (1)–(4)&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="220" height="140" as="geometry"/></mxCell>
