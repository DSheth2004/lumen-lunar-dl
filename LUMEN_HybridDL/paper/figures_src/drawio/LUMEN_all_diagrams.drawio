<mxCell id="v20" value='&lt;b style="font-size:13px;color:#1D4A80"&gt;16 replay&lt;/b&gt;&lt;div style="margin-top:4px;font-size:11px"&gt;synthetic spectra&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2F6DB5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="426" y="285" width="145" height="80" as="geometry"/></mxCell>
