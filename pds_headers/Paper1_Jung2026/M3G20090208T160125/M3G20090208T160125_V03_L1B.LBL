    LINES                    = 30398                                          
    LINE_SAMPLES             = 304                                            
    SAMPLE_TYPE              = PC_REAL                                        
    SAMPLE_BITS              = 32                                             
    UNIT                     = "W/(m^2 um sr)"                                
    BANDS                    = 85                                             
    BAND_STORAGE_TYPE        = LINE_INTERLEAVED                               
    LINE_DISPLAY_DIRECTION   = DOWN                                           
    SAMPLE_DISPLAY_DIRECTION = RIGHT                                          
  END_OBJECT                 = RDN_IMAGE                                      
                                                                              
