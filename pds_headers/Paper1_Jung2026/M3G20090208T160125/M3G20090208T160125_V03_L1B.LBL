/* Description of Radiance-corrected image file */                            
                                                                              
OBJECT          = RDN_FILE                                                    
  ^RDN_IMAGE    = "M3G20090208T160125_V03_RDN.IMG"                            
  RECORD_TYPE   = FIXED_LENGTH                                                
  RECORD_BYTES  = 103360                                                      
  FILE_RECORDS  = 30398                                                       
                                                                              
